{
  "id": "adobe",
  "kind": "plugin",
  "version": "1.0.13",
  "label": "Adobe",
  "description": "Control Illustrator, Photoshop, After Effects, Premiere Pro, PhotoCraft and VectorCraft from Ducky. COM, AfterFX -r scripts, a bundled Premiere bridge panel and the Craft apps' local control servers — no Node, no token, no extra MCP row.",
  "min_app_version": "1.2.357",
  "default_enabled": false,
  "data_sharing": false,
  "secret_keys": [],
  "contributes": {
    "agent.tools": {
      "category": "adobe",
      "intent_pattern": "\\b(adobe|illustrator|photoshop|artboard|extendscript|photocraft|photo ?craft|vectorcraft|vector ?craft|after ?effects|aftereffects|\\.aep|premiere|prproj|motion graphics|video edit(ing)?)\\b",
      "plan_tools": [
        "adobe_status",
        "adobe_list_tools",
        "illustrator_get_document_info",
        "illustrator_get_artboards",
        "illustrator_get_document_structure",
        "photoshop_get_state",
        "aftereffects_status",
        "aftereffects_project_info",
        "aftereffects_get_comp",
        "premiere_status",
        "premiere_project_info",
        "premiere_get_sequence",
        "photocraft_status",
        "photocraft_inspect",
        "vectorcraft_status",
        "vectorcraft_inspect"
      ]
    },
    "automations": {
      "nodes": [
        {
          "id": "adobe.status",
          "label": "Adobe status",
          "group": "Adobe",
          "description": "Report Illustrator / Photoshop readiness. Leave App empty to never launch; set it to open only that app.",
          "config_fields": [
            { "id": "app", "label": "App to launch (illustrator/photoshop, optional)", "type": "string" }
          ]
        },
        {
          "id": "illustrator.read",
          "label": "Read Illustrator doc",
          "group": "Adobe",
          "description": "Read the open Illustrator document (name, size, artboards).",
          "config_fields": []
        },
        {
          "id": "illustrator.open",
          "label": "Open Illustrator file",
          "group": "Adobe",
          "description": "Open a .ai path in Illustrator.",
          "config_fields": [
            { "id": "path", "label": "File path", "type": "string" }
          ]
        },
        {
          "id": "illustrator.save",
          "label": "Save Illustrator doc",
          "group": "Adobe",
          "description": "Save the open Illustrator document.",
          "config_fields": [
            { "id": "path", "label": "Save path (optional)", "type": "string" }
          ]
        },
        {
          "id": "illustrator.export",
          "label": "Export Illustrator",
          "group": "Adobe",
          "description": "Export artboards or selection as PNG / JPG / SVG.",
          "config_fields": [
            { "id": "format", "label": "Format (png/jpg/svg)", "type": "string" },
            { "id": "target", "label": "Target (artboard:all or artboard:0)", "type": "string" },
            { "id": "output_path", "label": "Output path (optional)", "type": "string" }
          ]
        },
        {
          "id": "photoshop.read",
          "label": "Read Photoshop state",
          "group": "Adobe",
          "description": "Read the open Photoshop document.",
          "config_fields": []
        },
        {
          "id": "photoshop.export",
          "label": "Export Photoshop",
          "group": "Adobe",
          "description": "Export the open Photoshop document as PNG or JPEG.",
          "config_fields": [
            { "id": "format", "label": "Format (png/jpg)", "type": "string" },
            { "id": "output_path", "label": "Output path", "type": "string" }
          ]
        },
        {
          "id": "aftereffects.read",
          "label": "Read After Effects project",
          "group": "Adobe",
          "description": "Read the open After Effects project: comps, sizes, durations, active item.",
          "config_fields": []
        },
        {
          "id": "aftereffects.render_frame",
          "label": "Render After Effects frame",
          "group": "Adobe",
          "description": "Render one comp frame to a PNG.",
          "config_fields": [
            { "id": "comp", "label": "Comp (optional: active comp)", "type": "string" },
            { "id": "time", "label": "Time in seconds (optional)", "type": "string" },
            { "id": "output_path", "label": "Output .png (optional)", "type": "string" }
          ]
        },
        {
          "id": "premiere.read",
          "label": "Read Premiere project",
          "group": "Adobe",
          "description": "Read the open Premiere Pro project: sequences, active sequence.",
          "config_fields": []
        },
        {
          "id": "premiere.export_frame",
          "label": "Export Premiere frame",
          "group": "Adobe",
          "description": "Export one sequence frame to a PNG.",
          "config_fields": [
            { "id": "sequence", "label": "Sequence (optional: active)", "type": "string" },
            { "id": "time", "label": "Time in seconds (optional: playhead)", "type": "string" },
            { "id": "output_path", "label": "Output .png (optional)", "type": "string" }
          ]
        },
        {
          "id": "adobe.jsx",
          "label": "Run ExtendScript",
          "group": "Adobe",
          "description": "Run raw JSX in Illustrator, Photoshop, After Effects or Premiere Pro.",
          "config_fields": [
            { "id": "app", "label": "App (illustrator/photoshop/aftereffects/premiere)", "type": "string" },
            { "id": "code", "label": "ExtendScript", "type": "textarea" }
          ]
        }
      ],
      "templates": [
        {
          "id": "adobe-brief-ducky",
          "label": "Illustrator briefs a ducky",
          "icon": "🎨",
          "description": "Read the open Illustrator file and spawn a ducky with that brief.",
          "requires_plugins": ["adobe"],
          "systems": ["automation"],
          "graph": {
            "nodes": [
              {
                "id": "t",
                "type": "start.manual",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Manual"
              },
              {
                "id": "r",
                "type": "illustrator.read",
                "x": 280,
                "y": 80,
                "config": {},
                "label": "Read Illustrator doc"
              },
              {
                "id": "s",
                "type": "ducky.spawn",
                "x": 520,
                "y": 80,
                "config": {
                  "title": "Illustrator",
                  "prompt": "Adobe is in-scope. Use illustrator_* on the open document. Do the art."
                },
                "label": "Spawn ducky"
              }
            ],
            "edges": [
              { "source": "t", "target": "r", "kind": "main" },
              { "source": "r", "target": "s", "kind": "main" }
            ]
          }
        },
        {
          "id": "adobe-export-illustrator",
          "label": "Export open Illustrator",
          "icon": "🖼️",
          "description": "Export every artboard from the open Illustrator file and return the files.",
          "requires_plugins": ["adobe"],
          "systems": ["pipeline"],
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat"
              },
              {
                "id": "e",
                "type": "illustrator.export",
                "x": 280,
                "y": 80,
                "config": { "format": "png", "target": "artboard:all" },
                "label": "Export Illustrator"
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 520,
                "y": 80,
                "config": { "message": "Illustrator export done." },
                "label": "Finish"
              }
            ],
            "edges": [
              { "source": "s", "target": "e", "kind": "main" },
              { "source": "e", "target": "f", "kind": "main" }
            ]
          }
        },
        {
          "id": "adobe-agent-then-export",
          "label": "Ducky draws then export",
          "icon": "🦆",
          "description": "A ducky edits the open Illustrator file, then export PNG artboards.",
          "requires_plugins": ["adobe"],
          "systems": ["pipeline"],
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat"
              },
              {
                "id": "a",
                "type": "pipeline.agent",
                "x": 260,
                "y": 80,
                "config": {
                  "title": "Illustrator",
                  "prompt": "Adobe is in-scope. Call illustrator_get_document_info, do the requested art with illustrator_*, then stop."
                },
                "label": "Agent"
              },
              {
                "id": "e",
                "type": "illustrator.export",
                "x": 500,
                "y": 80,
                "config": { "format": "png", "target": "artboard:all" },
                "label": "Export Illustrator"
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 740,
                "y": 80,
                "config": { "message": "Art exported." },
                "label": "Finish"
              }
            ],
            "edges": [
              { "source": "s", "target": "a", "kind": "main" },
              { "source": "a", "target": "e", "kind": "main" },
              { "source": "e", "target": "f", "kind": "main" }
            ]
          }
        },
        {
          "id": "adobe-aftereffects-animate",
          "label": "Ducky animates in After Effects",
          "icon": "🎞️",
          "description": "A ducky builds or edits the animation in the open After Effects project, then renders a frame to check it.",
          "requires_plugins": ["adobe"],
          "systems": ["pipeline"],
          "graph": {
            "nodes": [
              { "id": "s", "type": "start.chat", "x": 40, "y": 80, "config": {}, "label": "Chat" },
              {
                "id": "a",
                "type": "pipeline.agent",
                "x": 260,
                "y": 80,
                "config": {
                  "title": "After Effects",
                  "prompt": "Adobe is in-scope. Call aftereffects_project_info, build the requested animation with aftereffects_*, check it with aftereffects_render_frame, then stop."
                },
                "label": "Agent"
              },
              { "id": "r", "type": "aftereffects.render_frame", "x": 500, "y": 80, "config": {}, "label": "Render After Effects frame" },
              { "id": "f", "type": "pipeline.finish", "x": 740, "y": 80, "config": { "message": "Animation done." }, "label": "Finish" }
            ],
            "edges": [
              { "source": "s", "target": "a", "kind": "main" },
              { "source": "a", "target": "r", "kind": "main" },
              { "source": "r", "target": "f", "kind": "main" }
            ]
          }
        },
        {
          "id": "adobe-premiere-edit",
          "label": "Ducky edits in Premiere",
          "icon": "🎬",
          "description": "A ducky cuts the open Premiere Pro sequence, then exports a frame to check the edit.",
          "requires_plugins": ["adobe"],
          "systems": ["pipeline"],
          "graph": {
            "nodes": [
              { "id": "s", "type": "start.chat", "x": 40, "y": 80, "config": {}, "label": "Chat" },
              {
                "id": "a",
                "type": "pipeline.agent",
                "x": 260,
                "y": 80,
                "config": {
                  "title": "Premiere Pro",
                  "prompt": "Adobe is in-scope. Call premiere_status, then premiere_get_sequence, make the requested edit with premiere_*, read the sequence back, then stop."
                },
                "label": "Agent"
              },
              { "id": "e", "type": "premiere.export_frame", "x": 500, "y": 80, "config": {}, "label": "Export Premiere frame" },
              { "id": "f", "type": "pipeline.finish", "x": 740, "y": 80, "config": { "message": "Edit done." }, "label": "Finish" }
            ],
            "edges": [
              { "source": "s", "target": "a", "kind": "main" },
              { "source": "a", "target": "e", "kind": "main" },
              { "source": "e", "target": "f", "kind": "main" }
            ]
          }
        },
        {
          "id": "adobe-export-photoshop",
          "label": "Export open Photoshop",
          "icon": "📸",
          "description": "Export the open Photoshop document as PNG.",
          "requires_plugins": ["adobe"],
          "systems": ["pipeline"],
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat"
              },
              {
                "id": "e",
                "type": "photoshop.export",
                "x": 280,
                "y": 80,
                "config": { "format": "png" },
                "label": "Export Photoshop"
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 520,
                "y": 80,
                "config": { "message": "Photoshop export done." },
                "label": "Finish"
              }
            ],
            "edges": [
              { "source": "s", "target": "e", "kind": "main" },
              { "source": "e", "target": "f", "kind": "main" }
            ]
          }
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
